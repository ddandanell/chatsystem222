# Names only. Put real values in .env.local or the Vercel project. Never commit secrets.
#
# Neon / Vercel: use role mychef_runtime for DATABASE_URL and KEY_READER_DATABASE_URL.
# Local Docker: use inbox_app / inbox_key_reader (see docker-compose.yml). Do not point
# MIGRATION_DATABASE_URL at Neon.

# Required
DATABASE_URL=
KEY_READER_DATABASE_URL=
AUTH_SECRET=
BYOK_ENCRYPTION_KEY=
AUTH_URL=http://127.0.0.1:4317
OPERATOR_BOOTSTRAP_EMAIL=bali@mychef.id
OPERATOR_BOOTSTRAP_PASSWORD=

# Optional
# Vercel Cron calls GET /api/cron/learn with Authorization: Bearer CRON_SECRET. When empty,
# the route refuses every request. The pass only writes pending Learning Queue rows.
CRON_SECRET=
# Inbound GHL webhook. When empty the endpoint refuses every event with 503 (it used to accept
# anything). Requests must also carry x-ghl-timestamp within 300s; see documentation/webhook-security.md.
# Set GHL_WEBHOOK_REQUIRE_SIGNATURE=1 to refuse the shared-secret mode and require x-ghl-signature.
GHL_WEBHOOK_SECRET=
GHL_WEBHOOK_REQUIRE_SIGNATURE=

# Local Docker migrations only (not used on Vercel)
MIGRATION_DATABASE_URL=

# Generate AUTH_SECRET and BYOK_ENCRYPTION_KEY (32 bytes, base64):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
