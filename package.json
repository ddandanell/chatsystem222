{
  "name": "inbox-mychef",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 4317 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 4317 -H 0.0.0.0",
    "seed:operator": "node --env-file=.env.local --import tsx scripts/seed-operator.ts",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file=.env.local --import tsx src/db/seed.ts",
    "db:setup": "node --env-file=.env.local --import tsx src/db/migrate.ts && node --env-file=.env.local --import tsx src/db/seed.ts",
    "verify:rls": "node --env-file=.env.local --import tsx scripts/verify-rls.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:retrieval": "node --env-file=.env.local --import tsx scripts/verify-retrieval-policy.ts",
    "verify:isolation": "node --env-file=.env.local --import tsx scripts/verify-isolation.ts",
    "verify:groups": "node --env-file=.env.local --import tsx scripts/verify-groups.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
